{
  "cleanUrls": false,
  "installCommand": "NODE_OPTIONS=--openssl-legacy-provider yarn install",
  "buildCommand": "NODE_OPTIONS=--openssl-legacy-provider yarn build",
  "rewrites": [
    {
      "source": "/Users/Public/Documents/Portfolio/index.html",
      "destination": "/Users/Public/Documents/Portfolio"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    }
  ]
}
